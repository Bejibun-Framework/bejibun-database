{
    "name": "@bejibun/database",
    "version": "0.1.22",
    "author": "Havea Crenata <havea.crenata@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Bejibun-Framework/bejibun-database.git"
    },
    "main": "index.js",
    "module": "index.js",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bun": "^1.3.14",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "tsc-alias": "^1.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0"
    },
    "bugs": {
        "url": "https://github.com/Bejibun-Framework/bejibun-database/issues"
    },
    "description": "Database for Bejibun Framework",
    "homepage": "https://github.com/Bejibun-Framework/bejibun-database#readme",
    "keywords": [
        "bun",
        "bun framework",
        "database",
        "bejibun",
        "typescript"
    ],
    "license": "MIT",
    "scripts": {
        "alias": "tsc-alias -p tsconfig.json",
        "clean-stubs": "rm -rf stubs",
        "stubs": "cp -rf src/stubs dist",
        "rsync": "rsync -a dist/ ./",
        "clean": "rm -rf dist",
        "format": "prettier --write src --log-level=silent",
        "eslint": "eslint src",
        "lint": "bun run format && bun run eslint",
        "build": "bun run lint && bun run clean-stubs && tsc -p tsconfig.json && bun run alias && bun run stubs && bun run rsync && bun run clean",
        "deploy": "bun run build && bun publish --access public"
    },
    "type": "module",
    "types": "index.d.ts",
    "dependencies": {
        "@bejibun/app": "^0.1.25",
        "@bejibun/logger": "^0.1.23",
        "@bejibun/utils": "^0.1.29",
        "knex": "^3.3.0",
        "ora": "^9.4.1",
        "pg": "^8.23.0"
    }
}
